<Window
    x:Class="Family_Library.UI.Dialogs.LibraryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Perekonnateek"
    Width="492"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <!--
        Themed replacement for Revit TaskDialogs, following the Sentinel sheet: floating card, glyph + title,
        message, optional details and choices, buttons right-aligned (secondary left of primary).
        Enter = primary, Esc = cancel. The outer margin leaves room for the shadow.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Palette + materials are replaced at runtime by ThemeManager  -->
                <ResourceDictionary Source="pack://application:,,,/Family_Library;component/Revit/UI/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Family_Library;component/Revit/UI/Themes/LibraryStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Command link: a whole-row choice with a title and one line of explanation  -->
            <Style x:Key="ChoiceButton" TargetType="{x:Type Button}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                x:Name="Bd"
                                Padding="12,9"
                                Background="{DynamicResource Surface.Inset}"
                                BorderBrush="{DynamicResource Surface.Stroke}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Inset}"
                                RenderTransformOrigin="0.5,0.5">
                                <DockPanel>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Foreground="{DynamicResource Text.Tertiary}"
                                        Kind="ChevronRight" />
                                    <ContentPresenter />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Row.Hover}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Control.Stroke}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Control.Plain.Pressed}" />
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.99" ScaleY="0.99" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Card"
        Margin="16,12,16,24"
        Padding="22,20,22,18"
        MouseLeftButtonDown="Card_MouseLeftButtonDown"
        Style="{StaticResource Floating}"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <DockPanel>
            <!--  Buttons  -->
            <StackPanel
                x:Name="ButtonRow"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <Button
                    x:Name="SecondaryButton"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Click="Secondary_Click"
                    IsCancel="True"
                    Style="{StaticResource Button.Secondary}" />
                <Button
                    x:Name="PrimaryButton"
                    MinWidth="88"
                    Click="Primary_Click"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}" />
            </StackPanel>

            <!--  Glyph + title  -->
            <DockPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                <materialDesign:PackIcon
                    x:Name="Glyph"
                    Width="22"
                    Height="22"
                    Margin="0,0,12,0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource Accent.Text}" />
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    Style="{StaticResource Type.Section}"
                    TextWrapping="Wrap" />
            </DockPanel>

            <StackPanel Margin="34,0,0,0">
                <TextBlock x:Name="MessageText" Style="{StaticResource Type.Body}" />

                <!--  Choices (command links)  -->
                <StackPanel
                    x:Name="ChoicePanel"
                    Margin="0,14,0,0"
                    Visibility="Collapsed" />

                <!--  Details: selectable, scrolls when long (paths, error text)  -->
                <Border
                    x:Name="DetailsCard"
                    Margin="0,12,0,0"
                    Padding="10,8"
                    Style="{StaticResource InsetCard}"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="DetailsText"
                        MaxHeight="160"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="{StaticResource FontSize.Secondary}"
                        Foreground="{DynamicResource Text.Secondary}"
                        IsReadOnly="True"
                        SelectionBrush="{DynamicResource Accent}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
